{
  "info": {
    "name": "Jeogram Messenger API - Full Implementation",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Complete API with 20+ endpoints, rate limiting, validation, and more"
  },
  "item": [
    {
      "name": "Auth (5 endpoints)",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"},
            "url": {"raw": "http://localhost:8080/auth/register", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "register"]},
            "tests": ["if (pm.response.code === 201) { pm.collectionVariables.set(\"token\", pm.response.json().data.access_token); }"]
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"user@test.com\",\n  \"password\": \"password123\"\n}"},
            "url": {"raw": "http://localhost:8080/auth/login", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "login"]}
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"},
            "url": {"raw": "http://localhost:8080/auth/refresh", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "refresh"]}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/auth/logout", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "logout"]}
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/auth/me", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["auth", "me"]}
          }
        }
      ]
    },
    {
      "name": "User Status & Settings (8 endpoints)",
      "item": [
        {
          "name": "Set User Status",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"online\"\n}"},
            "url": {"raw": "http://localhost:8080/user/status", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "status"]}
          }
        },
        {
          "name": "Get User Status",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/user/status", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "status"]}
          }
        },
        {
          "name": "Update Settings",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"notifications_enabled\": true,\n  \"read_receipts\": true,\n  \"typing_indicators\": true,\n  \"online_status\": true,\n  \"theme\": \"dark\",\n  \"language\": \"en\",\n  \"privacy\": \"private\"\n}"},
            "url": {"raw": "http://localhost:8080/user/settings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "settings"]}
          }
        },
        {
          "name": "Get Settings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/user/settings", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "settings"]}
          }
        },
        {
          "name": "Block User",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"blocked_user_id\": \"user123\",\n  \"reason\": \"Spam messages\"\n}"},
            "url": {"raw": "http://localhost:8080/user/block", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "block"]}
          }
        },
        {
          "name": "Unblock User",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/user/unblock?blocked_user_id=user123", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "unblock"], "query": [{"key": "blocked_user_id", "value": "user123"}]}
          }
        },
        {
          "name": "Get Blocked Users",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/user/blocked", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["user", "blocked"]}
          }
        }
      ]
    },
    {
      "name": "Chat Management (8 endpoints)",
      "item": [
        {
          "name": "Get Chat Info",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/info", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "info"]}
          }
        },
        {
          "name": "Update Chat Info",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"name\": \"New Chat Name\",\n  \"description\": \"Chat description\",\n  \"avatar_url\": \"https://example.com/avatar.jpg\"\n}"},
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/info", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "info"]}
          }
        },
        {
          "name": "Get Chat Stats (Admin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/stats", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "stats"]}
          }
        },
        {
          "name": "Leave Chat",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/leave", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "leave"]}
          }
        },
        {
          "name": "Delete Chat (Owner)",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID"]}
          }
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/members?limit=50", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "members"], "query": [{"key": "limit", "value": "50"}]}
          }
        },
        {
          "name": "Mute Chat",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/mute?duration=24h", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "mute"], "query": [{"key": "duration", "value": "24h"}]}
          }
        },
        {
          "name": "Unmute Chat",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/mute", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "mute"]}
          }
        }
      ]
    },
    {
      "name": "Messages (10+ endpoints)",
      "item": [
        {
          "name": "Send Message",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"chat_id\": \"chat123\",\n  \"text\": \"Hello World\",\n  \"type\": \"text\"\n}"},
            "url": {"raw": "http://localhost:8080/messages", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages"]}
          }
        },
        {
          "name": "List Messages",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/messages?limit=50&offset=0", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "messages"], "query": [{"key": "limit", "value": "50"}, {"key": "offset", "value": "0"}]}
          }
        },
        {
          "name": "Reply to Message",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Reply to message\"\n}"},
            "url": {"raw": "http://localhost:8080/messages/MSG_ID/reply", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages", "MSG_ID", "reply"]}
          }
        },
        {
          "name": "Get Unsent Messages",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/messages/unsent", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages", "unsent"]}
          }
        },
        {
          "name": "Edit Message",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"text\": \"Edited message\"\n}"},
            "url": {"raw": "http://localhost:8080/messages/MSG_ID", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages", "MSG_ID"]}
          }
        },
        {
          "name": "Delete Message",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/messages/MSG_ID", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages", "MSG_ID"]}
          }
        },
        {
          "name": "Mark Read",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"message_ids\": [\"msg1\", \"msg2\"]\n}"},
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/read", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "read"]}
          }
        },
        {
          "name": "Add Reaction",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"emoji\": \"👍\"\n}"},
            "url": {"raw": "http://localhost:8080/messages/MSG_ID/reactions", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages", "MSG_ID", "reactions"]}
          }
        },
        {
          "name": "Pin Message",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/chats/CHAT_ID/pin/MSG_ID", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["chats", "CHAT_ID", "pin", "MSG_ID"]}
          }
        },
        {
          "name": "Search Messages",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "http://localhost:8080/messages/search?q=hello&limit=20", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["messages", "search"], "query": [{"key": "q", "value": "hello"}, {"key": "limit", "value": "20"}]}
          }
        }
      ]
    },
    {
      "name": "System Endpoints",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {"raw": "http://localhost:8080/health", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["health"]},
            "tests": ["pm.test(\"Status is OK\", function() { pm.expect(pm.response.json().status).to.equal(\"ok\"); });"]
          }
        },
        {
          "name": "Readiness Check",
          "request": {
            "method": "GET",
            "url": {"raw": "http://localhost:8080/ready", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["ready"]}
          }
        },
        {
          "name": "Prometheus Metrics",
          "request": {
            "method": "GET",
            "url": {"raw": "http://localhost:8080/metrics", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["metrics"]}
          }
        },
        {
          "name": "Swagger UI",
          "request": {
            "method": "GET",
            "url": {"raw": "http://localhost:8080/swagger/index.html", "protocol": "http", "host": ["localhost"], "port": "8080", "path": ["swagger", "index.html"]}
          }
        }
      ]
    }
  ],
  "variable": [
    {"key": "token", "value": "your-token-here"},
    {"key": "refresh_token", "value": "your-refresh-token-here"}
  ]
}
