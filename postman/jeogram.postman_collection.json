{
  "info": {
    "name": "Jeogram Messenger API",
    "description": "Коллекция запросов к бэкенду мессенджера Jeogram. Base URL по умолчанию: http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "chat_id", "value": "" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Регистрация",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"username\": \"alice\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "Вход",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var json = pm.response.json();",
                    "if (json.data && json.data.access_token) {",
                    "  pm.collectionVariables.set('access_token', json.data.access_token);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Обновление токена",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{access_token}}\"\n}"
            }
          }
        },
        {
          "name": "Я (профиль)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "User",
      "item": [
        {
          "name": "Поиск пользователей",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user/search?q=alice",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Настройки профиля",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/user/profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"display_name\": \"Алиса\"\n}" }
          }
        },
        {
          "name": "Получить настройки",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/user/settings",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Chats",
      "item": [
        {
          "name": "Создать приватный чат",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chats/private",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\"\n}"
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "var json = pm.response.json();",
                    "if (json.data && json.data.id) {",
                    "  pm.collectionVariables.set('chat_id', json.data.id);",
                    "}"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Создать групповой чат",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chats/group",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Команда\",\n  \"participant_ids\": [\"{{user_id}}\"]\n}"
            }
          }
        },
        {
          "name": "Мои чаты",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/chats",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Messages",
      "item": [
        {
          "name": "Отправить сообщение",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/messages",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat_id\": \"{{chat_id}}\",\n  \"type\": \"text\",\n  \"text\": \"Привет!\"\n}"
            }
          }
        },
        {
          "name": "Список сообщений",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/chats/{{chat_id}}/messages",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "Загрузить файл",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/media/upload",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "image", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Список уведомлений",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notifications",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }]
          }
        },
        {
          "name": "Зарегистрировать устройство (iOS/Android)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/notifications/device",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"platform\": \"android\",\n  \"token\": \"device-token-123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Calls",
      "item": [
        {
          "name": "Начать звонок",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/calls",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chat_id\": \"{{chat_id}}\",\n  \"type\": \"video\"\n}"
            }
          }
        }
      ]
    }
  ]
}
