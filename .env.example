# Пример переменных окружения. Скопируйте в .env и отредактируйте под себя.
APP_NAME=jeogram
APP_ENV=development
APP_VERSION=1.0.0

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s

# Драйвер БД: postgres (по умолчанию) или sqlite (локально без инфраструктуры)
DB_DRIVER=postgres
SQLITE_PATH=./jeogram.db

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jeogram
POSTGRES_PASSWORD=jeogram
POSTGRES_DB=jeogram
POSTGRES_SSLMODE=disable

# Redis можно отключить (refresh/logout перейдут в stateless-режим)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Kafka можно отключить (realtime будет работать напрямую через WebSocket)
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=jeogram-notifications
KAFKA_MESSAGE_TOPIC=message.created
KAFKA_NOTIFY_TOPIC=user.notifications

JWT_ACCESS_SECRET=dev-access-secret
JWT_REFRESH_SECRET=dev-refresh-secret
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=168h
JWT_ISSUER=jeogram

MEDIA_UPLOAD_DIR=./uploads
MEDIA_MAX_FILE_SIZE=26214400
MEDIA_BASE_URL=http://localhost:8080/media

METRICS_ENABLED=true
METRICS_PATH=/metrics

# Push-уведомления (опционально, по умолчанию отключены — только логирование)
PUSH_ENABLED=false
FCM_SERVER_KEY=
FCM_OAUTH_TOKEN=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=
APNS_BUNDLE_ID=
APNS_PRODUCTION=false

# --- Reverse proxy / SSL (Traefik, профиль `ssl`) ---
# Если DOMAIN пустой — приложение доступно по HTTP по IP (порт 8080).
# Если задать DOMAIN — Traefik выпускает Let's Encrypt и терминирует HTTPS.
# Запуск с SSL: docker compose --profile ssl --profile infra up -d
DOMAIN=
ACME_EMAIL=admin@example.com
# Режим выпуска сертификатов: production (по умолчанию) или staging (для тестов).
ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
